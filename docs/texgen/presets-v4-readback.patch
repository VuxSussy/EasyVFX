+-- Library v4 readback (tools/texgen): the same layers on generated textures.
+local function v4(layer: Layer, pack: string, extra: { [string]: any }?): Layer
+	layer.hd = true
+	layer.pack = pack
+	layer.texture = nil
+	if extra then
+		for k, v in extra do
+			layer[k] = v
+		end
+	end
+	return layer
+end
+
+local function v4Core(at: any, size: number): Layer
+	return {
+		type = "particles",
+		name = "Core",
+		hd = true,
+		pack = "shape_core_flash",
+		at = at,
+		burst = 1,
+		speed = { 0, 0 },
+		size = { { 0, size }, { 1, size * 0.4 } },
+		transparency = { { 0, 0 }, { 1, 1 } },
+		lifetime = { 0.07, 0.07 },
+		color = { "w" },
+		lightEmission = 1,
+		brightness = 3,
+		zOffset = 2,
+	}
+end
