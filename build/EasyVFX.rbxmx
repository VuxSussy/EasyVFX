      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">EclipseBridge</string>
          <string name="Source"><![CDATA[--!strict
--[[
	EasyVFX <-> Eclipse Animator.

	The AI ("vibe") flow:
	  1. Make an animation on a rig (Eclipse Animator's MCP tools save it into the
	     rig's AnimSaves folder as a KeyframeSequence).
	  2. attach() puts EasyVFX effects inside the rig, welded to a hand, weapon or
	     the root, so they follow the body.
	  3. writeEvents() writes Eclipse Animator's own event track into that animation
	     (the "EclipseEvents" folder, format version 8) with one event per effect
	     cue. Opening the animation in Eclipse shows the cues on its event track,
	     where they can be moved, retimed or removed by hand. It also writes the
	     KeyframeMarkers Eclipse would export, so the KeyframeSequence plays in a game
	     right away, before anyone opens Eclipse.
	  4. In the game, EasyVFX.BindAnimation(track, character) plays the full effects
	     (shapes, shakes and impact frames included) at those markers.

	Cues pointing at an effect inside the rig become Eclipse "Emits" (Eclipse's
	native way to fire VFX, previewed in its editor). Cues pointing at an effect
	elsewhere (templates in ReplicatedStorage.EasyVFX_Effects) become an "EasyVFX"
	marker on the event, which Eclipse keeps and exports as a KeyframeMarker.
]]

local HttpService = game:GetService("HttpService")

local Bridge = {}

Bridge.FOLDER = "EclipseEvents"
Bridge.FORMAT = 8 -- Eclipse Animator event document version
Bridge.FPS = 60 -- Eclipse's default FPS
Bridge.EFFECTS_FOLDER = "EasyVFX"

export type Cue = {
	time: number, -- seconds into the animation
	effect: Instance, -- an EasyVFX effect root
	name: string?, -- event label shown on the track
	at: string?, -- body part / attachment (marker cues only)
	offset: Vector3?, -- studs, marker cues only
	rot: Vector3?, -- degrees, marker cues only
}

-- Eclipse's emit path: one step per ancestor, matched by name, class and index
-- among same-named siblings.
function Bridge.path(root: Instance, target: Instance): { { Name: string, Class: string, Index: number } }?
	local path = {}
	local cursor: Instance? = target
	while cursor ~= root do
		if not cursor or not cursor.Parent then
			return nil
		end
		local index = 0
		for _, child in (cursor.Parent :: Instance):GetChildren() do
			if child.Name == cursor.Name and child.ClassName == cursor.ClassName then
				index += 1
			end
			if child == cursor then
				break
			end
		end
		table.insert(path, 1, { Name = cursor.Name, Class = cursor.ClassName, Index = index })
		cursor = cursor.Parent
	end
	return path
end

local function stringValue(parent: Instance, name: string, value: string)
	local v = Instance.new("StringValue")
	v.Name = name
	v.Value = value
	v.Parent = parent
end

local function markerPayload(cue: Cue): string
	local data: { [string]: any } = { effect = cue.effect.Name }
	if cue.at then
		data.at = cue.at
	end
	if cue.offset then
		data.offset = { cue.offset.X, cue.offset.Y, cue.offset.Z }
	end
	if cue.rot then
		data.rot = { cue.rot.X, cue.rot.Y, cue.rot.Z }
	end
	return HttpService:JSONEncode(data)
end

-- Moves an effect into the rig, welded to `partName` (a BasePart in the rig;
-- default HumanoidRootPart), placed at `offset` from it. Returns the effect.
function Bridge.attach(rig: Instance, effect: BasePart, partName: string?, offset: CFrame?): BasePart
	local found = rig:FindFirstChild(partName or "HumanoidRootPart", true)
	if not (found and found:IsA("BasePart")) then
		found = rig:FindFirstChildWhichIsA("BasePart", true)
	end
	assert(found and found:IsA("BasePart"), "rig has no parts to attach to")
	local part: BasePart = found
	local folder: Instance? = rig:FindFirstChild(Bridge.EFFECTS_FOLDER)
	if not folder then
		local f = Instance.new("Folder")
		f.Name = Bridge.EFFECTS_FOLDER
		f.Parent = rig
		folder = f
	end
	for _, j in effect:GetChildren() do
		if j:IsA("WeldConstraint") or j:IsA("JointInstance") then
			j:Destroy()
		end
	end
	effect.Anchored = false
	effect.CanCollide = false
	effect.CanQuery = false
	effect.CanTouch = false
	effect.Massless = true
	effect.CFrame = part.CFrame * (offset or CFrame.identity)
	effect:SetAttribute("VFX_Trigger", "Script") -- played by the animation, not on its own
	effect.Parent = folder
	local weld = Instance.new("WeldConstraint")
	weld.Name = "EasyVFX_Weld"
	weld.Part0 = part
	weld.Part1 = effect
	weld.Parent = effect
	return effect
end

-- Writes the cues as Eclipse Animator's event track on `sequence` (replacing any
-- previous track) plus the KeyframeMarkers Eclipse exports. Returns the folder.
function Bridge.writeEvents(rig: Instance, sequence: KeyframeSequence, cues: { Cue }, fps: number?): Folder
	local rate = fps or Bridge.FPS
	local folder = Instance.new("Folder")
	folder.Name = Bridge.FOLDER
	folder:SetAttribute("Version", Bridge.FORMAT)
	folder:SetAttribute("FPS", rate)
	folder:SetAttribute("DefaultFPS", Bridge.FPS)
	folder:SetAttribute("Enabled", true)
	folder:SetAttribute("FacesEnabled", false)
	folder:SetAttribute("ProjectSubtitles", false)
	folder:SetAttribute("Revision", 1)
	folder:SetAttribute("CreatedBy", "EasyVFX")
	stringValue(folder, "FaceKeys", "{}")

	-- Eclipse keeps one event per frame; cues on the same frame share it.
	local byFrame: { [number]: { emits: { any }, markers: { any }, names: { string } } } = {}
	local frames: { number } = {}
	for _, cue in cues do
		local frame = math.max(0, math.floor(cue.time * rate + 0.5))
		local slot = byFrame[frame]
		if not slot then
			slot = { emits = {}, markers = {}, names = {} }
			byFrame[frame] = slot
			table.insert(frames, frame)
		end
		local inRig = cue.effect:IsDescendantOf(rig)
		local path = if inRig then Bridge.path(rig, cue.effect) else nil
		if path then
			table.insert(slot.emits, { Mode = "All", Path = path })
		else
			table.insert(slot.markers, { Name = "EasyVFX", Parameter = markerPayload(cue) })
		end
		table.insert(slot.names, cue.name or cue.effect.Name:gsub("^VFX_", ""))
	end
	table.sort(frames)

	for _, frame in frames do
		local slot = byFrame[frame]
		local item = Instance.new("Folder")
		item.Name = HttpService:GenerateGUID(false)
		item:SetAttribute("Frame", frame)
		item:SetAttribute("Duration", 0)
		item:SetAttribute("Speed", 1)
		local label = table.concat(slot.names, " + ")
		local markers = slot.markers
		if #markers == 0 then
			-- an event always has a name; the first marker is what Eclipse displays
			markers = { { Name = label, Parameter = "" } }
		end
		item:SetAttribute("EventName", markers[1].Name)
		item:SetAttribute("Parameter", markers[1].Parameter)
		item:SetAttribute("Enabled", true)
		stringValue(item, "Markers", HttpService:JSONEncode(markers))
		stringValue(item, "CodeBegin", "")
		stringValue(item, "CodeEnd", "")
		stringValue(item, "Emits", HttpService:JSONEncode(slot.emits))
		local sounds = Instance.new("Folder")
		sounds.Name = "Sounds"
		sounds.Parent = item
		item.Parent = folder
	end

	-- KeyframeMarkers, as Eclipse's export writes them, so the animation works in
	-- a game before it is ever opened in Eclipse. Old EasyVFX/Eclipse markers go.
	local keyAt: { [number]: Keyframe } = {}
	for _, key in sequence:GetKeyframes() do
		if key:IsA("Keyframe") then
			for _, marker in key:GetMarkers() do
				if marker.Name == "EclipseVFX" or marker.Name == "EasyVFX" then
					marker:Destroy()
				end
			end
			keyAt[math.floor(key.Time * rate + 0.5)] = key
		end
	end
	for _, frame in frames do
		local slot = byFrame[frame]
		local key = keyAt[frame]
		if not key then
			local k = Instance.new("Keyframe")
			k.Name = "Keyframe"
			k.Time = frame / rate
			k.Parent = sequence
			keyAt[frame] = k
			key = k
		end
		assert(key)
		if #slot.emits > 0 then
			local marker = Instance.new("KeyframeMarker")
			marker.Name = "EclipseVFX"
			marker.Value = HttpService:JSONEncode({ Version = 1, Emits = slot.emits })
			marker.Parent = key
		end
		for _, m in slot.markers do
			local marker = Instance.new("KeyframeMarker")
			marker.Name = m.Name
			marker.Value = m.Parameter
			marker.Parent = key
		end
	end

	local previous = sequence:FindFirstChild(Bridge.FOLDER)
	folder.Parent = sequence
	if previous and previous ~= folder then
		previous:Destroy()
	end
	if sequence:GetAttribute("EclipseEventDocumentId") == nil then
		sequence:SetAttribute("EclipseEventDocumentId", HttpService:GenerateGUID(false))
	end
	if rig:GetAttribute("EclipseEventRigId") == nil then
		rig:SetAttribute("EclipseEventRigId", HttpService:GenerateGUID(false))
	end
	return folder
end

-- Reads back an Eclipse event track (written by Eclipse or by writeEvents) as a
-- list of { frame, time, markers, emits } so a tool can inspect what's there.
function Bridge.readEvents(sequence: KeyframeSequence): { any }
	local folder = sequence:FindFirstChild(Bridge.FOLDER)
	local out = {}
	if not folder then
		return out
	end
	local fps = folder:GetAttribute("FPS")
	local rate = if type(fps) == "number" and fps > 0 then fps else Bridge.FPS
	for _, item in folder:GetChildren() do
		local frame = item:GetAttribute("Frame")
		if item:IsA("Folder") and type(frame) == "number" then
			local function json(name: string): any
				local v = item:FindFirstChild(name)
				if not (v and v:IsA("StringValue")) then
					return {}
				end
				local ok, data = pcall(function()
					return HttpService:JSONDecode(v.Value)
				end)
				return if ok and type(data) == "table" then data else {}
			end
			table.insert(out, { frame = frame, time = frame / rate, markers = json("Markers"), emits = json("Emits") })
		end
	end
	table.sort(out, function(a, b)
		return a.frame < b.frame
	end)
	return out
end

return Bridge
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Presets</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Ready-made effects. Every preset is plain data that Builder turns into instances.

	Layer types
	  particles  ParticleEmitter. `burst = n` makes it a one-shot (EmitCount), otherwise
	             it streams with `rate`. `at` = "part" (whole effect volume),
	             "center", or a Vector3 offset in studs.
	  shape      Crisp procedural piece played by the runtime (Ring, Slash, Lines, Bolt,
	             Orb, Debris, Crater). `attrs` are written as attributes.
	  light      PointLight. `flash = seconds` makes it a quick fading flash.
	  beam       Static Beam between two offsets (lasers).
	  trail      Trail along the longest side of the effect part (weapon swings).
	  part       Static visible part (shield bubble, energy core).
	  highlight  Outline glow on the object the effect is attached to.

	Colors: "p" = main color, "s" = second color, "w" = white, "k" = soot black,
	"d" = dark version of main color, or any Color3.
	Sizes / times / counts are multiplied by the Size, Speed, Lifetime and Amount
	sliders in the plugin.
]]

local Presets = {}

Presets.Textures = {
	Glow = "rbxasset://textures/particles/explosion01_implosion_main.dds",
	Ring = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Star = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Blast = "rbxasset://textures/particles/explosion01_core_main.dds",
	Bubble = "rbxasset://textures/particles/forcefield_vortex_main.dds",
	Square = "rbxasset://textures/particles/SquareParticle.png",
}

local T = Presets.Textures

export type Layer = { [string]: any }
export type Preset = {
	id: string,
	category: string,
	name: { vi: string, en: string },
	desc: { vi: string, en: string },
	kind: string, -- "loop" | "burst"
	style: string?, -- "dark" for the dark fantasy look, nil otherwise
	placement: string?, -- "ground" | "sky" | "air"
	area: Vector3?,
	defaults: { [string]: any },
	layers: { Layer },
}

-- Grouped by what the effect is for, so the library stays easy to scan. The look
-- (dark fantasy...) is a separate filter: Presets.Styles.
Presets.Categories = {
	{ id = "all", vi = "Tất cả", en = "All" },
	{ id = "slash", vi = "Chém", en = "Slashes" },
	{ id = "impact", vi = "Va chạm & nổ", en = "Impacts & Explosions" },
	{ id = "projectile", vi = "Đạn, tia & lướt", en = "Projectiles, Beams & Dashes" },
	{ id = "aura", vi = "Hào quang & buff", en = "Auras & Buffs" },
	{ id = "circle", vi = "Vòng phép & cổng", en = "Circles & Portals" },
	{ id = "elements", vi = "Nguyên tố", en = "Elements" },
	{ id = "world", vi = "Môi trường", en = "Environment" },
	{ id = "custom", vi = "Của tôi", en = "My Effects" },
}

Presets.Styles = {
	{ id = "all", vi = "Mọi phong cách", en = "All styles" },
	{ id = "dark", vi = "Hắc ám", en = "Dark Fantasy" },
}


local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Reusable sharp spark streaks (crisp square texture stretched along velocity).
local function sparks(count: number, speed: number, at: any?): Layer
	return {
		type = "particles",
		at = at or "center",
		texture = T.Square,
		burst = count,
		color = { "w", "p" },
		size = { { 0, 0.22 }, { 1, 0 } },
		squash = { { 0, -2.5 }, { 1, -2.5 } },
		orientation = "VelocityParallel",
		lifetime = { 0.35, 0.7 },
		speed = { speed * 0.6, speed },
		spread = { 180, 180 },
		drag = 5,
		accel = Vector3.new(0, -25, 0),
		lightEmission = 1,
		brightness = 2,
	}
end

-- HD (asset pack) layers ------------------------------------------------------
-- These only appear after the Blender pack is imported. They are flat particles
-- (VelocityPerpendicular + tiny speed), so the texture lies in the attachment's
-- plane; `rotatable` adds the plugin's Rotation slider to their angle.

local function hdSlash(o: { [string]: any }): { Layer }
	local radius = o.radius or 5
	local quad = radius / 0.48 -- the crescent's outer edge is at 48% of the texture
	local life = o.life or 0.34
	local rot = o.rotation or 0
	local spin = (o.sweep or 50) / life
	local common = {
		hd = true,
		group = o.group,
		tilt = o.tilt,
		randomTilt = o.randomTilt,
		delay = o.delay,
		orientation = "VelocityPerpendicular",
		direction = "Top",
		speed = { 0.01, 0.01 },
		rotation = { rot, rot },
		rotSpeed = { spin, spin },
		rotatable = true,
		lightEmission = 1,
		at = o.at or "center",
	}
	local function with(extra: { [string]: any }): Layer
		local layer = table.clone(common)
		for k, v in extra do
			layer[k] = v
		end
		return layer
	end
	return {
		with({
			type = "particles",
			name = "SlashHD",
			pack = "slash_arc",
			burst = 1,
			size = { { 0, quad * 0.82 }, { 0.12, quad }, { 1, quad * 1.12 } },
			transparency = { { 0, 0 }, { 0.45, 0.05 }, { 1, 1 } },
			lifetime = { life, life },
			color = { "w", "w", "p", "s" },
			brightness = 4,
			zOffset = 1,
		}),
		with({
			type = "particles",
			name = "SlashDissolve",
			pack = "flip_slash",
			flipbook = "Grid4x4",
			flipMode = "OneShot",
			burst = 1,
			size = { { 0, quad * 1.0 }, { 1, quad * 1.16 } },
			transparency = { { 0, 0.15 }, { 1, 0.35 } },
			lifetime = { life * 1.3, life * 1.3 },
			color = { "p", "s" },
			brightness = 2,
			zOffset = 0.5,
		}),
		{
			type = "particles",
			name = "Twinkles",
			hd = true,
			group = o.group,
			tilt = o.tilt,
			randomTilt = o.randomTilt,
			pack = "spark_star",
			at = o.at or "center",
			delay = (o.delay or 0) + 0.04,
			burst = o.twinkles or 16,
			direction = "Front",
			speed = { radius * 3, radius * 6 },
			drag = 5,
			spread = { 80, 80 },
			size = { { 0, 0 }, { 0.15, 0.8 }, { 1, 0 } },
			lifetime = { 0.35, 0.8 },
			rotation = { 0, 360 },
			color = { "w", "p" },
			lightEmission = 1,
			brightness = 2,
		},
	}
end

local hdSlashLayers = hdSlash

-- Marks a layer as "only without the HD pack".
local function basic(layer: Layer): Layer
	layer.basic = true
	return layer
end

local function hdRing(at: any, size1: number, life: number, tilt: Vector3?, delay: number?): Layer
	return {
		type = "particles",
		name = "RingHD",
		hd = true,
		pack = "ring_wave",
		at = at,
		tilt = tilt,
		delay = delay,
		burst = 1,
		orientation = "VelocityPerpendicular",
		direction = "Top",
		speed = { 0.01, 0.01 },
		size = { { 0, size1 * 0.08 }, { 1, size1 } },
		transparency = { { 0, 0 }, { 0.6, 0.25 }, { 1, 1 } },
		lifetime = { life, life },
		rotation = { 0, 360 },
		color = { "w", "p", "s" },
		lightEmission = 1,
		brightness = 2,
	}
end

local function hdFlip(pack: string, at: any, count: number, size: { any }, life: { number }, extra: { [string]: any }?): Layer
	local layer: Layer = {
		type = "particles",
		name = "FlipHD",
		hd = true,
		pack = pack,
		at = at,
		flipbook = "Grid4x4",
		flipMode = "OneShot",
		burst = count,
		size = size,
		lifetime = life,
		rotation = { 0, 360 },
		color = { "w", "p" },
		lightEmission = 1,
		brightness = 2,
	}
	if extra then
		for k, v in extra do
			layer[k] = v
		end
	end
	return layer
end

local function hdDust(count: number): Layer
	return hdFlip("flip_smoke", Vector3.new(0, -1.6, 0), count, { { 0, 2.5 }, { 1, 6 } }, { 0.9, 1.4 }, {
		color = { "g" },
		lightEmission = 0,
		lightInfluence = 1,
		brightness = 1,
		speed = { 8, 14 },
		spread = { 90, 90 },
		drag = 4,
		transparency = { { 0, 0.15 }, { 1, 0.6 } },
	})
end

local function dust(count: number, at: any?): Layer
	return {
		type = "particles",
		at = at or Vector3.new(0, -1.5, 0),
		texture = T.Smoke,
		burst = count,
		color = { "g" },
		size = { { 0, 2 }, { 1, 5 } },
		transparency = { { 0, 0.4 }, { 1, 1 } },
		lifetime = { 1, 1.8 },
		speed = { 10, 18 },
		spread = { 90, 90 },
		direction = "Top",
		drag = 5,
		rotation = { 0, 360 },
		rotSpeed = { -40, 40 },
		lightEmission = 0,
		lightInfluence = 1,
	}
end


-- Dark fantasy helpers ---------------------------------------------------------
-- Dark bodies are unlit (lightEmission 0, lightInfluence 1) so black and blood red
-- really cover the scene; a thin additive core or ember keeps them readable.

local function darkSmoke(count: number, at: any?, extra: { [string]: any }?): Layer
	local layer: Layer = {
		type = "particles",
		at = at or "center",
		texture = T.Smoke,
		burst = count,
		color = { "x", "k" },
		size = { { 0, 2 }, { 1, 6 } },
		transparency = { { 0, 0.15 }, { 0.6, 0.35 }, { 1, 1 } },
		lifetime = { 1.2, 2 },
		speed = { 3, 7 },
		spread = { 180, 180 },
		drag = 3,
		accel = Vector3.new(0, 2, 0),
		rotation = { 0, 360 },
		rotSpeed = { -40, 40 },
		lightEmission = 0,
		lightInfluence = 1,
		zOffset = -0.5,
	}
	if extra then
		for k, v in extra do
			layer[k] = v
		end
	end
	return layer
end

local function embers(rate: number, at: any?, color: { any }?): Layer
	return {
		type = "particles",
		at = at or "part",
		texture = T.Square,
		rate = rate,
		color = color or { "w", "p", "s" },
		size = { { 0, 0.14 }, { 0.7, 0.1 }, { 1, 0 } },
		squash = { { 0, -1.2 }, { 1, -1.2 } },
		orientation = "VelocityParallel",
		lifetime = { 1.5, 3 },
		speed = { 1, 3 },
		spread = { 40, 40 },
		accel = Vector3.new(0, 2.5, 0),
		drag = 1,
		lightEmission = 1,
		brightness = 2,
	}
end


-- Impact kit -------------------------------------------------------------------
-- What makes a hit feel heavy (see docs/impact.md): a hard white hit spark held for
-- a couple of frames, a crisp ring that is gone before the main effect, a short
-- hit-stop, a camera kick and a small FOV punch. The HD layers use the v3 Blender
-- textures and simply drop out when they are not available.

local function hitSpark(at: any, size: number, delay: number?): { Layer }
	return {
		{
			type = "particles",
			name = "HitStarHD",
			hd = true,
			pack = "hit_star",
			at = at,
			delay = delay,
			burst = 1,
			size = { { 0, size * 0.8 }, { 0.3, size }, { 1, size * 1.1 } },
			transparency = { { 0, 0 }, { 0.5, 0 }, { 1, 1 } },
			lifetime = { 0.09, 0.09 }, -- a 2-3 frame hold
			rotation = { 0, 360 },
			color = { "w" },
			lightEmission = 1,
			brightness = 4,
			zOffset = 3,
		},
		{
			type = "particles",
			name = "HitSparkHD",
			hd = true,
			pack = "flip_hitspark",
			at = at,
			delay = (delay or 0) + 0.03,
			flipbook = "Grid4x4",
			flipMode = "OneShot",
			burst = 1,
			size = { { 0, size * 1.1 }, { 1, size * 1.6 } },
			lifetime = { 0.32, 0.32 },
			rotation = { 0, 360 },
			color = { "w", "p", "s" },
			lightEmission = 1,
			brightness = 3,
			zOffset = 2.5,
		},
	}
end

local function hardRing(at: any, size: number, life: number, tilt: Vector3?, delay: number?): Layer
	return {
		type = "particles",
		name = "RingHardHD",
		hd = true,
		pack = "ring_hard",
		at = at,
		tilt = tilt,
		delay = delay,
		burst = 1,
		orientation = "VelocityPerpendicular",
		direction = "Top",
		speed = { 0.01, 0.01 },
		size = { { 0, size * 0.15 }, { 0.35, size * 0.85 }, { 1, size } },
		transparency = { { 0, 0 }, { 0.4, 0.1 }, { 1, 1 } },
		lifetime = { life, life },
		color = { "w", "p" },
		lightEmission = 1,
		brightness = 3,
	}
end

-- hit-stop + FOV punch + camera kick, scaled by how heavy the hit is (0..1)
local function weight(heavy: number, at: Vector3?, delay: number?): { Layer }
	return {
		{ type = "shape", kind = "HitStop", attrs = { Delay = delay or 0, Duration = 0.04 + 0.05 * heavy } },
		{ type = "shape", kind = "Punch", attrs = { Offset = at, Delay = delay or 0, Amount = -(2 + 6 * heavy), Duration = 0.18 + 0.15 * heavy } },
		{ type = "shape", kind = "Shake", attrs = { Offset = at, Delay = delay or 0, Kick = true, Magnitude = 1 + 2 * heavy, Duration = 0.2 + 0.25 * heavy, Roughness = 26 } },
	}
end

-- extra layers per preset (appended after the list below)
local IMPACT_KIT: { [string]: { Layer } } = {}

Presets.List = ({
	------------------------------------------------------------------ Combat
	{
		id = "fireball",
