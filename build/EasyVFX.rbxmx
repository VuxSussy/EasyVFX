          <string name="Source"><![CDATA[--!strict
-- All text shown in the plugin, in Vietnamese and English.

local Strings = {}

Strings.vi = {
	tabCreate = "Tạo VFX",
	createTitle = "Tự tạo hiệu ứng",
	createIntro = "Ghép các khối có sẵn thành hiệu ứng của riêng bạn. Hiệu ứng đã lưu nằm trong thư viện (mục \"Của tôi\") và dùng được ở mọi place.",
	createName = "Tên hiệu ứng",
	createKind = "Kiểu phát",
	createBlocks = "Các khối (%d)",
	createAdd = "THÊM KHỐI",
	colorMain = "Màu chính",
	colorSecond = "Màu phụ",
	colorWhite = "Trắng",
	colorVoid = "Bóng tối",
	blockDark = "Kiểu tối (thân đen, viền sáng)",
	blockDelay = "Trễ",
	blockSize = "Kích thước",
	blockAmount = "Số lượng / cường độ",
	blockUp = "Lên",
	blockRemove = "Xóa",
	createSaveAdd = "Lưu & thêm vào game",
	createSave = "Lưu",
