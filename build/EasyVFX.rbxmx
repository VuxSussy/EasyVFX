	slash_fiber = "rbxassetid://86334360833977",
	slash_glow = "rbxassetid://110558506665611",
	spark_star = "rbxassetid://74475827199936",
	spark_streak = "rbxassetid://90179582471630",
	-- v3: impact & sharpness (docs/impact.md)
	arc_electric = "rbxassetid://115248336686988",
	flip_hitspark = "rbxassetid://79450510348314",
	hit_star = "rbxassetid://84110628902184",
